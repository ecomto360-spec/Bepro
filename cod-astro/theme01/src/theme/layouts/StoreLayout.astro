---
import "@/theme/styles/global.css";
import BaseHead from "@/theme/components/layout/BaseHead.astro";
import Header from "@/theme/components/layout/Header.astro";
import Footer from "@/theme/components/layout/Footer.astro";
import CartDrawer from "@/theme/components/cart/CartDrawer.astro";
import MobileNav from "@/theme/components/layout/MobileNav.astro";
import WhatsAppWidget from "@/theme/components/chat/WhatsAppWidget.astro";
import ProductScripts from "@/theme/components/products/ProductScripts.astro";
import type { StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { DEFAULT_CONFIG } from "@/theme/config/store";
import { copy, type BeproLocale } from "@/theme/content/bepro";

interface Props { title?: string; description?: string; ogImage?: string; noindex?: boolean; config?: StoreConfig; content?: StoreFrontContent; hideMobileNav?: boolean; marketing?: boolean; preloadImages?: string[]; }
const { title, description, ogImage, noindex, content, marketing = false, preloadImages } = Astro.props;
const hideMobileNav = marketing || Astro.props.hideMobileNav;
const requested = Astro.url.searchParams.get("lang");
if (requested === "ar" || requested === "fr") Astro.cookies.set("bepro_lang", requested, { path: "/", sameSite: "lax", maxAge: 31536000 });
const selected = requested === "ar" || requested === "fr" ? requested : Astro.cookies.get("bepro_lang")?.value;
const config = { ...(Astro.props.config ?? DEFAULT_CONFIG), lang: selected === "ar" ? "ar" : "fr" } as StoreConfig;
const lang = config.lang as BeproLocale;
const t = copy[lang];
const isRTL = lang === "ar";
const pageTitle = title ?? config.metaTitle ?? (lang === "ar" ? "bepro | متجرك الرياضي في الجزائر" : "bepro | Votre boutique sport en Algérie");
const pageDesc = description ?? config.metaDescription ?? t.heroText;
const pageOg = ogImage ?? config.ogImage ?? "/demo/hero-sport.webp";
const HEX = /^#[0-9a-fA-F]{3,8}$/;
const primary = HEX.test(config.primaryColor) ? config.primaryColor : "#075bbf";
const accent = HEX.test(config.accentColor) ? config.accentColor : "#ea580c";
const bg = HEX.test(config.bgColor) ? config.bgColor : "#ffffff";
const font = "Inter, Cairo, Tajawal, sans-serif";
const fontHref = "https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800;900&family=Tajawal:wght@400;500;700;800&display=swap";
---
<!doctype html>
<html lang={lang} dir={isRTL ? "rtl" : "ltr"}>
  <BaseHead title={pageTitle} description={pageDesc} ogImage={pageOg} noindex={noindex} config={config} primary={primary} accent={accent} bg={bg} font={font} fontHref={fontHref} preloadImages={preloadImages} />
  <body class:list={[!hideMobileNav && "has-mobile-nav"]}>
    <a class="skip-link" href="#main-content">{lang === "ar" ? "انتقل إلى المحتوى" : "Aller au contenu"}</a>
    {!marketing && <div class="top-marquee" aria-label={t.delivery}><div class="marquee-track">{Array.from({ length: 6 }).map(() => <><span>{t.delivery}</span><i>✦</i><span>{t.cod}</span><i>✦</i><span>{t.support}</span><i>✦</i></>)}</div></div>}
    {!marketing && <Header config={config} content={content} />}
    <main id="main-content"><slot /></main>
    {!marketing && <Footer config={config} content={content} />}
    {!marketing && <CartDrawer config={config} content={content} />}
    {!hideMobileNav && <MobileNav config={config} />}
    {!marketing && <WhatsAppWidget config={config} widget={config.whatsapp} content={content} />}
    {!marketing && <ProductScripts config={config} />}
    <div class="bepro-toast" role="status" aria-live="polite" data-bepro-toast hidden></div>
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "SportingGoodsStore", name: "bepro", url: Astro.url.origin, telephone: "+213550000000", address: { "@type": "PostalAddress", addressCountry: "DZ" }, priceRange: "DZD" })} />
  </body>
</html>
