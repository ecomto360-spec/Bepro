---
import type { StoreConfig } from "@/core/api/types";
import { copy, type BeproLocale } from "@/theme/content/bepro";
const { config } = Astro.props as { config: StoreConfig };
const t = copy[(config.lang === "ar" ? "ar" : "fr") as BeproLocale];
---
<div id="cart-scrim" class="drawer-backdrop" data-cart-backdrop hidden></div>
<aside id="cart-drawer" class="cart-drawer" data-cart-drawer aria-label={t.cartTitle} hidden>
  <template data-drawer-line-template><a data-cart-image-link href="/products"><img alt="" /></a><a data-cart-name href="/products"></a></template>
  <div class="drawer-head"><h2>{t.cartTitle} (<span data-cart-count>0</span>)</h2><button class="icon-button" type="button" data-cart-close aria-label={t.close}>×</button></div>
  <div class="drawer-items" data-drawer-items></div>
  <div class="drawer-footer" data-drawer-footer hidden><div class="drawer-total"><span>{t.subtotal}</span><span data-drawer-subtotal></span></div><a class="button button-primary button-block" href="/checkout">{t.checkout}</a><a class="button button-outline button-block" href="/cart">{t.cart}</a></div>
</aside>
<script>
  const emptyLabel = document.documentElement.lang === "ar" ? "سلتك فارغة" : "Votre panier est vide";
  const emptyText = document.documentElement.lang === "ar" ? "اكتشف تشكيلتنا وأضف أساسياتك الرياضية." : "Découvrez notre sélection et ajoutez vos essentiels sport.";
  const continueLabel = document.documentElement.lang === "ar" ? "مواصلة التسوق" : "Continuer mes achats";
  const removeLabel = document.documentElement.lang === "ar" ? "إزالة" : "Retirer";
  import { getCart, subscribe, cartCount, cartSubtotal, setQuantity, removeLine, lineKey, type CartLine } from "@/theme/scripts/cart";
  const drawer = document.querySelector<HTMLElement>("[data-cart-drawer]");
  const backdrop = document.querySelector<HTMLElement>("[data-cart-backdrop]");
  const list = document.querySelector<HTMLElement>("[data-drawer-items]");
  const footer = document.querySelector<HTMLElement>("[data-drawer-footer]");
  function openCart() { if (drawer && backdrop) { drawer.hidden = false; backdrop.hidden = false; drawer.setAttribute("data-open", ""); backdrop.setAttribute("data-open", ""); document.body.classList.add("menu-open"); } }
  function closeCart() { if (drawer && backdrop) { drawer.hidden = true; backdrop.hidden = true; drawer.removeAttribute("data-open"); backdrop.removeAttribute("data-open"); document.body.classList.remove("menu-open"); } }
  document.querySelectorAll("[data-cart-open]").forEach((b) => b.addEventListener("click", openCart));
  document.querySelectorAll("[data-cart-close]").forEach((b) => b.addEventListener("click", closeCart));
  backdrop?.addEventListener("click", closeCart);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeCart(); });
  function render(lines: CartLine[]) {
    document.querySelectorAll("[data-cart-count]").forEach((el) => { el.textContent = String(cartCount(lines)); });
    document.querySelectorAll("[data-drawer-subtotal]").forEach((el) => { el.textContent = `${cartSubtotal(lines).toLocaleString("fr-DZ")} DA`; });
    if (!list || !footer) return;
    list.replaceChildren(); footer.hidden = lines.length === 0;
    if (!lines.length) {
      const empty = document.createElement("div"); empty.className = "empty-state";
      const title = document.createElement("h3"); title.textContent = emptyLabel;
      const text = document.createElement("p"); text.textContent = emptyText;
      const link = document.createElement("a"); link.className = "button button-primary"; link.href = "/products"; link.textContent = continueLabel;
      empty.append(title, text, link); list.append(empty); return;
    }
    lines.forEach((line) => {
      const key = lineKey(line.productId, line.variantId);
      const row = document.createElement("article"); row.className = "drawer-item";
      const image = document.createElement("img"); image.src = line.image || "/demo/products/performance-running.webp"; image.alt = ""; image.width = 76; image.height = 76;
      const info = document.createElement("div"); const title = document.createElement("h3"); title.textContent = line.productName;
      const variant = document.createElement("small"); variant.textContent = line.variantLabel || "";
      const actions = document.createElement("div"); actions.className = "drawer-item-actions";
      const minus = document.createElement("button"); minus.textContent = "−"; minus.setAttribute("aria-label", "−"); minus.addEventListener("click", () => setQuantity(key, line.quantity - 1));
      const qty = document.createElement("strong"); qty.textContent = String(line.quantity);
      const plus = document.createElement("button"); plus.textContent = "+"; plus.setAttribute("aria-label", "+"); plus.addEventListener("click", () => setQuantity(key, line.quantity + 1));
      const remove = document.createElement("button"); remove.className = "drawer-remove"; remove.textContent = removeLabel; remove.addEventListener("click", () => removeLine(key));
      actions.append(minus, qty, plus, remove); info.append(title, variant, actions);
      const price = document.createElement("span"); price.className = "drawer-item-price"; price.textContent = `${(line.unitPrice * line.quantity).toLocaleString("fr-DZ")} DA`;
      row.append(image, info, price); list.append(row);
    });
  }
  render(getCart()); subscribe(render);
</script>
<style>
  #cart-drawer[data-open], #cart-scrim[data-open] { visibility: visible; }
  :global([dir="rtl"]) #cart-drawer { inset-inline: auto 0; }
  :global([dir="rtl"]) #cart-drawer[data-open] { transform: translateX(0); }
</style>
