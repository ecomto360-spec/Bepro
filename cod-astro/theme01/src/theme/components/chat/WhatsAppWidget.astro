---
import type { StoreConfig, StoreWhatsAppWidget } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/content";
import { en as defaultContent } from "@/theme/content/en";
import { showsWidgetOn } from "@/theme/utils/shows-widget-on";
import WhatsAppWidgetPanel from "./WhatsAppWidgetPanel.astro";

interface Props {
  widget?: StoreWhatsAppWidget | null;
  content?: StoreFrontContent;
  config: StoreConfig;
}
const { widget, config } = Astro.props;
const content = Astro.props.content || defaultContent;
const showPanel = widget && showsWidgetOn(widget.surfaces, Astro.url.pathname);
---
{showPanel ? (
  <WhatsAppWidgetPanel widget={widget} content={content} config={config} />
) : !widget ? (
  <a class="whatsapp-float" href="https://wa.me/213555555555" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.6-4.7a8.5 8.5 0 1 1 15.9-4.2Z"/><path d="M8.2 7.5c.2-.4.4-.4.7-.4h.5l.8 2c.1.3 0 .5-.2.7l-.6.7c.7 1.4 1.7 2.4 3.2 3.1l.7-.9c.2-.2.4-.3.7-.2l2 .9c.3.1.4.3.4.6 0 1-.6 1.8-1.5 2.1-.7.2-1.5.1-2.7-.4-2.8-1.2-4.7-3.2-5.5-5.4-.4-1-.4-2 .1-2.8Z"/></svg>
  </a>
) : null}
