---
import type { StoreConfig } from "@/core/api/types";
import { copy, type BeproLocale } from "@/theme/content/bepro";
const { config } = Astro.props as { config: StoreConfig };
const t = copy[(config.lang === "ar" ? "ar" : "fr") as BeproLocale];
const path = Astro.url.pathname;
---
<nav class="mobile-bottom-nav mobile-only" aria-label={t.menu}>
  <a href="/" aria-current={path === "/" ? "page" : undefined}><svg viewBox="0 0 24 24"><path d="m3 11 9-8 9 8v10h-6v-6H9v6H3V11Z"/></svg><span>{t.home}</span></a>
  <a href="/products" aria-current={path.startsWith("/products") ? "page" : undefined}><svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></svg><span>{t.products}</span></a>
  <button type="button" data-cart-open><span class="mobile-cart-icon"><svg viewBox="0 0 24 24"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L21 8H6M10 21h.01M17 21h.01"/></svg><b data-cart-count>0</b></span><span>{t.cart}</span></button>
  <a href="/track-order" aria-current={path === "/track-order" ? "page" : undefined}><svg viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7zM7 21h.01M18 21h.01"/></svg><span>{t.track}</span></a>
</nav>
