---
import type { StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { copy, categoryNames, type BeproLocale } from "@/theme/content/bepro";
const { config } = Astro.props as { config: StoreConfig; content?: StoreFrontContent };
const lang = (config.lang === "ar" ? "ar" : "fr") as BeproLocale;
const t = copy[lang];
const alternate = new URL(Astro.url); alternate.searchParams.set("lang", lang === "fr" ? "ar" : "fr");
const categories = [
  ["chaussures-de-sport", "shoe"], ["vetements-de-sport", "shirt"], ["sacs-de-sport", "bag"], ["equipements-entrainement", "weights"], ["accessoires", "watch"],
] as const;
---
<header class="bepro-header">
  <div class="container header-main">
    <button class="icon-button mobile-only" type="button" data-menu-open aria-label={t.menu}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="brand" href="/" aria-label="bepro — accueil">
      <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true"><path d="M8 8h18c9 0 14 4 14 11 0 4-2 7-6 9 5 1 8 4 8 9 0 8-6 11-16 11H8V8Zm12 9v7h5c3 0 5-1 5-4s-2-3-5-3h-5Zm0 15v7h6c4 0 6-1 6-4s-2-3-6-3h-6Z"/></svg>
      <span>bepro<span>.</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Navigation principale">
      <a href="/">{t.home}</a><a href="/products">{t.products}</a><a href="/track-order">{t.track}</a>
    </nav>
    <div class="header-actions">
      <a class="language-link" href={`${alternate.pathname}${alternate.search}`} hreflang={lang === "fr" ? "ar" : "fr"}>{t.language}</a>
      <a class="icon-button desktop-only" href="/track-order" aria-label={t.track}><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-5 3-8 8-8s8 3 8 8"/></svg></a>
      <button class="icon-button cart-trigger" type="button" data-cart-open aria-label={t.cart}>
        <svg viewBox="0 0 24 24"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L21 8H6M10 21h.01M17 21h.01"/></svg>
        <span data-cart-count class="cart-count">0</span>
      </button>
    </div>
  </div>
  <div class="container category-row desktop-only">
    <details class="category-menu">
      <summary><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>{t.categories}<span>⌄</span></summary>
      <div class="category-popover">
        {categories.map(([slug]) => <a href={`/category/${slug}`}>{categoryNames[slug][lang]}<span>→</span></a>)}
      </div>
    </details>
    {categories.map(([slug]) => <a class="category-link" href={`/category/${slug}`}>{categoryNames[slug][lang]}</a>)}
  </div>
</header>
<div class="mobile-menu" data-mobile-menu hidden>
  <button class="menu-backdrop" data-menu-close aria-label={t.close}></button>
  <aside class="menu-panel" aria-label={t.menu}>
    <div class="menu-head"><strong>bepro.</strong><button class="icon-button" data-menu-close aria-label={t.close}>×</button></div>
    <nav><a href="/">{t.home}</a><a href="/products">{t.products}</a><a href="/track-order">{t.track}</a><a href="/cart">{t.cart}</a></nav>
    <p class="menu-label">{t.categories}</p>
    <nav>{categories.map(([slug]) => <a href={`/category/${slug}`}>{categoryNames[slug][lang]}<span>←</span></a>)}</nav>
    <a class="button button-primary menu-cta" href={`${alternate.pathname}${alternate.search}`}>{t.language}</a>
  </aside>
</div>
<script>
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  document.querySelectorAll("[data-menu-open]").forEach((button) => button.addEventListener("click", () => { if (menu) { menu.hidden = false; document.body.classList.add("menu-open"); } }));
  document.querySelectorAll("[data-menu-close]").forEach((button) => button.addEventListener("click", () => { if (menu) { menu.hidden = true; document.body.classList.remove("menu-open"); } }));
</script>
