---
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import ProductCard from "@/theme/components/products/ProductCard.astro";
import { getStoreContext } from "@/theme/config/store";
import { fetchCatalogProducts, fetchCategoriesRaw } from "@/core/api/client";
import { copy, categoryNames, type BeproLocale } from "@/theme/content/bepro";
const { config: baseConfig, content } = await getStoreContext();
const requested = Astro.url.searchParams.get("lang") ?? Astro.cookies.get("bepro_lang")?.value;
const lang = (requested === "ar" ? "ar" : "fr") as BeproLocale;
const config = { ...baseConfig, lang };
const t = copy[lang]; const slug = Astro.params.slug ?? "";
const [allProducts, categories] = await Promise.all([fetchCatalogProducts({ limit: 100 }), fetchCategoriesRaw()]);
const category = categories.find((c) => c.slug === slug);
if (!category) return Astro.redirect("/products");
const title = categoryNames[slug]?.[lang] ?? category.name;
const products = allProducts.filter((p) => p.category?.slug === slug || p.categoryId === category.id);
---
<StoreLayout config={config} content={content} title={`${title} | bepro`} description={`${title} — ${t.heroText}`}>
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">{t.home}</a><span>/</span><a href="/products">{t.categories}</a><span>/</span><span>{title}</span></div><h1>{title}</h1><p>{products.length} {t.results} · {t.cod} · {t.delivery}</p></div></section>
  <section class="section"><div class="container"><div class="filter-chips">{categories.map((c) => <a class:list={["filter-chip", c.slug === slug && "active"]} href={`/category/${c.slug}`}>{categoryNames[c.slug]?.[lang] ?? c.name}</a>)}</div><div class="product-grid">{products.map((product) => <ProductCard product={product} config={config} />)}</div><p style="margin-top:30px"><a class="button button-outline" href="/products">{t.viewAll} →</a></p></div></section>
</StoreLayout>
