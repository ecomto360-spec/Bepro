-/* ── WhatsApp Panel Positioning ──────────────────────────────────────────── */
-.wa-panel {
-  /* Mobile: fixed positioning centered horizontally, anchored to bottom with safe spacing */
-  position: fixed;
-  bottom: calc(var(--wa-bottom) + 4.5rem);
-  left: 50%;
-  transform: translateX(-50%);
-  width: calc(100vw - 2rem);
-  max-width: 22rem;
-  margin: 0 auto;
-}
-
-/* Desktop: absolute positioning relative to launcher, positioned above it */
-@media (min-width: 640px) {
-  .wa-panel {
-    position: absolute;
-    bottom: calc(100% + 0.75rem);
-    left: auto;
-    transform: none;
-    width: 20rem;
-  }
-  
-  /* Right-aligned widget: panel aligns to the right edge */
-  .wa-widget[data-position="right"] .wa-panel {
-    right: 0;
-    left: auto;
-  }
-  
-  /* Left-aligned widget: panel aligns to the left edge */
-  .wa-widget[data-position="left"] .wa-panel {
-    left: 0;
-    right: auto;
-  }
-}
-
-/* Ensure panel doesn't exceed viewport on mobile */
-.wa-panel {
-  max-height: calc(100vh - var(--wa-bottom) - 5.5rem);
-}
