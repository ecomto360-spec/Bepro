# bepro / CodFlow — modèle d'environnement
# Copier les variables nécessaires dans .env ou .dev.vars, puis renseigner les valeurs localement.
# Ne jamais committer les fichiers contenant les valeurs réelles.

# Cloudflare / ressources
COD_ACCOUNT_ID=
COD_DB_NAME=
COD_R2_BUCKET_NAME=
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# API et origines
COD_SERVER_URL=
COD_MEDIA_DOMAIN=
MEDIA_DOMAIN=
WORKER_URL=
WORKER_SELF_URL=
BETTER_AUTH_URL=
PUBLIC_API_URL=
PUBLIC_APP_URL=
PUBLIC_TRUSTED_ORIGINS=
ALLOWED_ORIGINS=
ENVIRONMENT=

# Authentification et chiffrement
STORE_API_KEY=
BETTER_AUTH_SECRET=
MCP_LOGIN_TICKET_SECRET=
MCP_REQUEST_STATE_KEY=
COOKIE_ENCRYPTION_KEY=

# Administration locale (utilisée uniquement par les scripts de seed)
ADMIN_EMAIL=
ADMIN_NAME=
